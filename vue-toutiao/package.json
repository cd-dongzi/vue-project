{
  "name": "toutiao",
  "version": "1.0.0",
  "private": true,
  "description": "Educational Vue 2 mobile news application",
  "main": "index.js",
  "scripts": {
    "predev": "node build/ensure-dll.js",
    "dev": "webpack-dev-server --config build/webpack.dev.conf.js",
    "start": "npm run dev",
    "prebuild": "node build/ensure-dll.js",
    "build": "node build/build.js",
    "dll": "node node_modules/webpack/bin/webpack.js -p --progress --config build/webpack.dll.conf.js",
    "test:ensure-dll": "node build/ensure-dll.test.js && node build/dll-command.test.js",
    "test:storage": "node src/utils/storage-value.test.js && node src/utils/storage.test.js",
    "test:fetch": "node src/utils/fetch.test.js",
    "test:article-route": "node src/views/Article/load-article-when-changed.test.js",
    "test:home-scroll": "node src/views/Home/scroll-position.test.js",
    "test:home-end-indicator": "node src/views/Home/end-indicator.test.js",
    "test:home-tags": "node src/store/modules/home-tags.test.js",
    "test:loading-state": "node src/store/modules/loading-state.test.js",
    "test:router-permission": "node src/router/permission.test.js",
    "test:login": "node src/components/Login/login.test.js",
    "test:loading-more": "node src/views/loading-more-error.test.js",
    "test:record-empty-state": "node src/views/Record/empty-state.test.js",
    "test:record-route-index": "node src/views/Record/route-index.test.js",
    "test:video-playback": "node src/views/Video/playback.test.js",
    "test:scroll-directive": "node src/directive/scroll.test.js",
    "test": "npm run test:ensure-dll && npm run test:storage && npm run test:fetch && npm run test:article-route && npm run test:home-scroll && npm run test:home-end-indicator && npm run test:home-tags && npm run test:loading-state && npm run test:router-permission && npm run test:login && npm run test:loading-more && npm run test:record-empty-state && npm run test:record-route-index && npm run test:video-playback && npm run test:scroll-directive",
    "analyze": "cross-env analyz_npm_config_report=true npm run build",
    "analyz": "npm run analyze"
  },
  "author": "cd-dongzi",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/cd-dongzi/vue-project.git",
    "directory": "vue-toutiao"
  },
  "bugs": {
    "url": "https://github.com/cd-dongzi/vue-project/issues"
  },
  "homepage": "https://github.com/cd-dongzi/vue-project#readme",
  "engines": {
    "node": ">=14 <17",
    "npm": ">=6"
  },
  "devDependencies": {
    "babel-core": "^6.26.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-polyfill": "^6.26.0",
    "babel-preset-env": "^1.6.1",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-stage-2": "^6.24.1",
    "babel-register": "^6.26.0",
    "chalk": "^6.0.0",
    "compression-webpack-plugin": "^12.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "extract-text-webpack-plugin": "^3.0.2",
    "file-loader": "^6.2.0",
    "friendly-errors-webpack-plugin": "^1.6.1",
    "html-webpack-plugin": "^5.6.8",
    "less": "^4.9.0",
    "less-loader": "^13.0.0",
    "node-notifier": "^10.0.1",
    "optimize-css-assets-webpack-plugin": "^6.0.1",
    "ora": "^9.4.1",
    "postcss-loader": "^8.2.1",
    "rimraf": "^6.1.3",
    "url-loader": "^4.1.1",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.110.3",
    "webpack-bundle-analyzer": "^5.3.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "axios": "^0.17.1",
    "babel-polyfill": "^6.26.0",
    "qs": "^6.5.1",
    "vue": "^2.5.13",
    "vue-awesome-swiper": "^3.1.2",
    "vue-router": "^3.0.1",
    "vuex": "^3.0.1"
  }
}
